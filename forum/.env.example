# Set these in the process environment; the app does not implicitly load .env.
FORUM_DATABASE_URL=postgresql+psycopg://forum:local-development-only@127.0.0.1:55432/forum
FORUM_ENV=development
FORUM_PUBLIC_ORIGIN=http://127.0.0.1:5175
# Local UI test identity only. Cannot be enabled when FORUM_ENV=production.
FORUM_ALLOW_DEV_AUTH=0
FORUM_ADMIN_IDS=
# Existing site's auth DB. Production adapter opens this READ ONLY.
CLOUD_AUTH_DB=
FORUM_PLAY_ORIGIN=https://play.2048tables.online
# Exact reverse-proxy peer CIDRs only; proxy must overwrite X-Real-IP.
FORUM_TRUSTED_PROXIES=
# Set the same high-entropy secret on every API process for shared IP limits.
FORUM_IP_HASH_SECRET=
