# Copy to /etc/2048tables/cloud.env on Ubuntu and adjust paths.
CLOUD_MODE=1
APP_MODE=cloud
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=warning
UVICORN_ACCESS_LOG=0
WS_MAX_ACTIVE_CONNECTIONS=1024
WS_MAX_ACTIVE_CONNECTIONS_PER_IP=24

# Tablebase manifest and data root.
# TABLEBASE_CATALOG_PATH can normally stay unset because the repo default is docs_and_configs/cloud_tablebases.json.
# TABLEBASE_ROOT overrides the manifest root without exposing it to the frontend.
TABLEBASE_ROOT=/opt/2048tables/tablebases

# Remote Windows tablebase workers. Generate a long random secret and set the
# same value in the Worker's TABLEBASE_WORKER_TOKEN environment variable.
# REMOTE_TABLEBASE_WORKER_SECRET=replace-with-at-least-32-random-characters
REMOTE_TABLEBASE_HEARTBEAT_TIMEOUT_SECONDS=30
REMOTE_TABLEBASE_REQUEST_TIMEOUT_SECONDS=30

# Temporary browser upload/download/job storage.
CLOUD_UPLOAD_ROOT=/var/lib/2048tables/uploads
CLOUD_MAX_UPLOAD_BYTES=52428800
CLOUD_MAX_REPLAY_UPLOAD_BYTES=512000
CLOUD_MAX_ANALYSIS_UPLOAD_BYTES=512000
CLOUD_UPLOAD_TTL_SECONDS=21600
