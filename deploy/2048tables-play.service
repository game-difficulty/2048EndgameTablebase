[Unit]
Description=2048 Play API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/2048tables/play/current
EnvironmentFile=/etc/2048tables/cloud.env
EnvironmentFile=/etc/2048tables/play.env
ExecStart=/opt/2048tables/venv/bin/python -m uvicorn backend.human_play.production_app:app --host 127.0.0.1 --port 8766 --workers 1 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
